rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'mrponleu20000@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation for Templates
    function isValidTemplate(data) {
      return data.keys().hasAny(['id']) && data.id is string && data.id.size() <= 128;
    }

    // Validation for Music Tracks
    function isValidMusicTrack(data) {
      return data.keys().hasAny(['id']) && data.id is string && data.id.size() <= 128;
    }

    // Validation for Couples
    function isValidCouple(data) {
      return data.keys().hasAny(['id']) && data.id is string && data.id.size() <= 128;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow create: if isValidId(templateId) && isValidTemplate(incoming());
      allow update: if isValidId(templateId) && isValidTemplate(incoming());
      allow delete: if isValidId(templateId);
    }

    match /musicTracks/{trackId} {
      allow read: if true;
      allow create: if isValidId(trackId) && isValidMusicTrack(incoming());
      allow update: if isValidId(trackId) && isValidMusicTrack(incoming());
      allow delete: if isValidId(trackId);
    }

    match /couples/{coupleId} {
      allow read: if true; 
      allow create: if isValidId(coupleId) && isValidCouple(incoming());
      allow update: if isValidId(coupleId) && isValidCouple(incoming());
      allow delete: if isValidId(coupleId);
    }
  }
}
